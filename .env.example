APP_NAME=LiveBids
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=livebids
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@livebids.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Storage / S3 / MinIO (Private KYC bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=livebids-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb (WebSockets Real-Time Bidding)
REVERB_APP_ID=livebids-reverb-app
REVERB_APP_KEY=livebids-reverb-key
REVERB_APP_SECRET=livebids-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Welfare Identity & Verification (NIN & Liveness)
WELFARE_VERIFICATION_BASE_URL=https://verification.welfare.ng
WELFARE_VERIFICATION_API_KEY=
WELFARE_VERIFICATION_CLIENT_ID=

# Welfare Notifications (SMS OTP & FCM Push)
WELFARE_NOTIFICATIONS_BASE_URL=https://notifications.welfare.ng
WELFARE_NOTIFICATIONS_API_KEY=

# Video Streaming (Self-Hosted LiveKit WebRTC SFU)
VIDEO_DRIVER=null # Use 'livekit' for production, 'null' for dev/test
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Auction Engine Parameters
AUCTION_COMMISSION_PERCENTAGE=10
AUCTION_BID_INCREMENT_PERCENTAGE=5
AUCTION_BID_INCREMENT_FLOOR_KOBO=10000
AUCTION_LIVE_DURATION_SECONDS=180
AUCTION_GRACE_WINDOW_SECONDS=600
AUCTION_DECISION_WINDOW_SECONDS=60
AUCTION_ESCROW_AUTO_RELEASE_HOURS=72
AUCTION_DAILY_NOTIFICATION_CAP=5

# Feature Flags
FEATURE_BIDDING_ENABLED=true
FEATURE_WITHDRAWALS_ENABLED=true
FEATURE_NEW_SIGNUPS_ENABLED=true
FEATURE_KYC_REQUIRED=true
